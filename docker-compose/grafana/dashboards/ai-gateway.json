{
  "title": "AI Gateway",
  "uid": "ai-gateway",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["ai-platform-lab", "ai-gateway"],
  "panels": [
    {
      "id": 1,
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "datasource": null,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_http_requests_total[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inference duration (p99)",
      "type": "timeseries",
      "datasource": null,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ai_gateway_inference_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tokens / second (Ollama)",
      "type": "stat",
      "datasource": null,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "avg(ai_gateway_tokens_per_second)",
          "legendFormat": "tokens/s"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error rate",
      "type": "timeseries",
      "datasource": null,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_errors_total[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "RAG retrieved chunks (median)",
      "type": "timeseries",
      "datasource": null,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(ai_gateway_rag_retrieved_chunks_bucket[5m])) by (le))",
          "legendFormat": "median chunks"
        }
      ]
    }
  ]
}
