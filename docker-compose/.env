# Environment Configuration
# Generated for Enterprise Middleware SRE Platform

# Database
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass

# Redis
REDIS_PASSWORD=redispass

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# Application
NODE_ENV=production
JAVA_OPTS=-Xmx1024m -Xms512m

# AI Platform (ai profile: docker compose --profile ai up -d)
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
QDRANT_COLLECTION_NAME=lab-docs
MLFLOW_TRACKING_URI=http://localhost:5000
